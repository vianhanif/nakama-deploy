# nakama-deploy environment template
# Copy to overlays/local/secret.yaml (k8s) or a local .env (compose).
# DO NOT commit real values.

# Required. Base64-encoded 32 random bytes. Generate once:
#   openssl rand -base64 32
# The server refuses to start without it, and refuses to read existing
# encrypted secrets if it changes. Store a copy in the team password manager.
NAKAMA_SECRETS_KEY=

# Optional: skip the first-boot setup wizard (all three together, or none).
# NAKAMA_SEED_ADMIN_EMAIL=admin@example.com
# NAKAMA_SEED_ADMIN_NAME=Admin
# NAKAMA_SEED_ADMIN_PASSWORD=

# Optional: public URL when running behind a reverse proxy (OAuth callbacks).
# NAKAMA_WEB_PUBLIC_URL=

# LLM provider: configure in the dashboard under Control Center → AI providers
# using the `openai_compatible` provider pointed at the 9router gateway.
